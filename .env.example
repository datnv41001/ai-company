# Development only. Generate a new random secret before using real accounts.
APP_ENV=local
AMC_HTTP_PORT=8000
POSTGRES_PASSWORD=
AMC_RUNTIME_PASSWORD=
DATABASE_URL=sqlite:///./amc_local.db
JWT_SECRET=REPLACE-WITH-AT-LEAST-32-RANDOM-CHARACTERS
JWT_ISSUER=amc-local
# Immediate reverse-proxy CIDRs that overwrite X-Real-IP, empty for direct access
AMC_IDENTITY_TRUSTED_PROXIES=
# Optional worker-only read-only secret directory
AMC_WORKER_SECRET_DIR=./.worker-secrets

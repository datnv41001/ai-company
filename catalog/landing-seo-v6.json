  "marketing_methods": {
    "landing-conversion@1": {
      "id": "landing-conversion",
      "version": 1,
      "role": "content",
      "task": "Write useful customer-facing conversion copy grounded in the offer.",
      "inputs": [
        "product",
        "audience",
        "region",
        "channel",
        "facts",
        "locale"
      ],
      "method": "Lead with the buyer's job. Turn a documented attribute into a decision and end with one executable next step on the selected channel. Leave prices to the structured offer block.",
      "applicability": "Retail, service booking and trade quote pages",
      "references": [
        "K-02",
        "K-06"
      ],
      "examples": {
        "good": {
          "headline": "Choose coverage for your floor plan",
          "value_proposition": "Plan a quote using the area of your project.",
          "benefit": "Compare the coverage per pack with the area you need.",
          "call_to_action": "Send your area and project location for a quote."
        },
        "bad": "Increase campaign conversions by promising the lowest price."
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "value_proposition": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "benefit": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "call_to_action": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "required": [
          "headline",
          "value_proposition",
          "benefit",
          "call_to_action"
        ],
        "additionalProperties": false
      },
      "rubric": [
        "One coherent headline, value proposition and fact-supported benefit.",
        "A concrete buyer action suited to the permitted channel."
      ],
      "prohibited": "Internal goals, invented offers, performance guarantees or seller instructions.",
      "tests": [
        {
          "case": "example_positive",
          "expected": "all structured output fields and applicable sources are present"
        },
        {
          "case": "example_negative",
          "expected": "One coherent headline, value proposition and fact-supported benefit."
        }
      ],
      "release": "Publish the reviewed workflow manifest containing this exact skill version and digest; activate only on the selected campaign.",
      "rollback": "Disable the candidate workflow for new runs and activate the previous compatible workflow. Retain pinned definitions and existing run receipts."
    },
    "search-intent-seo@1": {
      "id": "search-intent-seo",
      "version": 1,
      "role": "seo",
      "task": "Write consistent search metadata for the actual page.",
      "inputs": [
        "product",
        "region",
        "channel",
        "facts",
        "locale"
      ],
      "method": "Identify a plausible buyer query, align the title with page content, and summarize the distinguishing offer in a descriptive snippet. A suggested snippet is not a ranking prediction.",
      "applicability": "Local-intent service pages and product detail pages",
      "references": [
        "K-06",
        "K-08"
      ],
      "examples": {
        "good": {
          "page_title": "Tile pack coverage for local project quotes",
          "meta_description": "Check pack coverage and supply your required area to request a project quote.",
          "search_intent": "Compare tile pack coverage before asking for a quote."
        },
        "bad": "Rank number one: increase our company's conversion KPI."
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "page_title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "meta_description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "search_intent": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "required": [
          "page_title",
          "meta_description",
          "search_intent"
        ],
        "additionalProperties": false
      },
      "rubric": [
        "Match both metadata fields to the actual asset.",
        "Use the buyer's intent, not the seller's campaign objective."
      ],
      "prohibited": "Guaranteed rankings, traffic forecasts, keyword stuffing or unsupported promotions.",
      "tests": [
        {
          "case": "example_positive",
          "expected": "all structured output fields and applicable sources are present"
        },
        {
          "case": "example_negative",
          "expected": "Match both metadata fields to the actual asset."
        }
      ],
      "release": "Publish the reviewed workflow manifest containing this exact skill version and digest; activate only on the selected campaign.",
      "rollback": "Disable the candidate workflow for new runs and activate the previous compatible workflow. Retain pinned definitions and existing run receipts."
    }
  }
}

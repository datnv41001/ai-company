{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amc:airc500:contracts:v1",
  "title": "AIRC-500 review artifact contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/assignment"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/finding"
    },
    {
      "$ref": "#/$defs/review"
    },
    {
      "$ref": "#/$defs/exchange"
    },
    {
      "$ref": "#/$defs/arbitration"
    },
    {
      "$ref": "#/$defs/checkpoint"
    }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "repository",
        "pr_number",
        "merge_base",
        "integration_sha",
        "catalog_digest",
        "policy_digest",
        "source_manifest_digest",
        "implementer_principals",
        "mode",
        "risk",
        "dependency_map_digest",
        "budget"
      ],
      "properties": {
        "type": {
          "const": "run.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "merge_base": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "integration_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementer_principals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "enum": [
            "targeted",
            "full"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "dependency_map_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrency",
        "max_tokens",
        "max_cost_microusd",
        "deadline_utc",
        "attempt_timeout_seconds",
        "max_retries",
        "max_debate_rounds",
        "paid_approval_id",
        "tariff_digest"
      ],
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "deadline_utc": {
          "type": "string",
          "format": "date-time"
        },
        "attempt_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "enum": [
            0,
            1
          ]
        },
        "max_debate_rounds": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "paid_approval_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tariff_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "reviewer_id",
        "assignment_id",
        "principal",
        "phase",
        "round",
        "topic",
        "reason",
        "context_digest",
        "tool_grant_digest",
        "output_contract",
        "artifact_kind",
        "token_reservation",
        "cost_reservation_microusd"
      ],
      "properties": {
        "type": {
          "const": "assignment.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^(PM|MK|SE|AI|SP|UX|QT|BF|LC|IO|ID|AR)-[0-9]{3}$"
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "blind",
            "cross",
            "arbitration"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tool_grant_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_contract": {
          "type": "string",
          "minLength": 1
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1
        },
        "token_reservation": {
          "type": "integer",
          "minimum": 1
        },
        "cost_reservation_microusd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "reviewer_id",
        "model",
        "model_version",
        "family",
        "assignment_id",
        "attempt_id",
        "phase",
        "round",
        "context_digest",
        "started_utc",
        "ended_utc",
        "outcome",
        "output_digest",
        "usage_known",
        "input_tokens",
        "output_tokens",
        "cost_microusd",
        "adapter_identity",
        "provider_request_or_local_execution_id",
        "signature",
        "model_digest",
        "lease_epoch"
      ],
      "properties": {
        "type": {
          "const": "receipt.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^(PM|MK|SE|AI|SP|UX|QT|BF|LC|IO|ID|AR)-[0-9]{3}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "blind",
            "cross",
            "arbitration"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "started_utc": {
          "type": "string",
          "format": "date-time"
        },
        "ended_utc": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "output_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_known": {
          "type": "boolean"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_identity": {
          "type": "string",
          "minLength": 1
        },
        "provider_request_or_local_execution_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key_id",
            "algorithm",
            "signature_version",
            "value"
          ],
          "properties": {
            "key_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "algorithm": {
              "const": "Ed25519"
            },
            "signature_version": {
              "const": 1
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{86}==$"
            }
          }
        },
        "model_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "output_digest": {
                "type": "string"
              },
              "usage_known": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "usage_known": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "input_tokens": {
                "type": "integer"
              },
              "output_tokens": {
                "type": "integer"
              },
              "cost_microusd": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "digest",
        "excerpt_or_observation",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "pinned_blob",
            "sandbox_attestation",
            "approved_reference",
            "sealed_artifact"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "excerpt_or_observation": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side",
        "path",
        "start_line",
        "end_line"
      ],
      "properties": {
        "side": {
          "enum": [
            "base",
            "head"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "reviewer_id",
        "model",
        "model_version",
        "family",
        "finding_id",
        "attempt_id",
        "severity",
        "location",
        "location_note",
        "expected",
        "actual",
        "business_impact",
        "reproduction",
        "evidence",
        "proposed_fix",
        "acceptance_criteria",
        "verification_status",
        "counterarguments",
        "unresolved_disagreements"
      ],
      "properties": {
        "type": {
          "const": "finding.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^(PM|MK|SE|AI|SP|UX|QT|BF|LC|IO|ID|AR)-[0-9]{3}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "IDEA"
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "location_note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "business_impact": {
          "type": "string",
          "minLength": 1
        },
        "reproduction": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "proposed_fix": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_status": {
          "enum": [
            "candidate",
            "verified",
            "rejected",
            "unresolved"
          ]
        },
        "counterarguments": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_disagreements": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "location": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "location_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "reviewer_id",
        "assignment_id",
        "attempt_id",
        "phase",
        "artifact_kind",
        "proof_observation",
        "scope_reviewed",
        "gaps",
        "finding_ids",
        "evidence"
      ],
      "properties": {
        "type": {
          "const": "review.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^(PM|MK|SE|AI|SP|UX|QT|BF|LC|IO|ID|AR)-[0-9]{3}$"
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "blind",
            "cross",
            "arbitration"
          ]
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1
        },
        "proof_observation": {
          "type": "string",
          "minLength": 1
        },
        "scope_reviewed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gaps": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finding_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "reviewer_id",
        "attempt_id",
        "message_id",
        "target_finding_id",
        "round",
        "kind",
        "reason",
        "evidence",
        "supersedes"
      ],
      "properties": {
        "type": {
          "const": "exchange.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^(PM|MK|SE|AI|SP|UX|QT|BF|LC|IO|ID|AR)-[0-9]{3}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "target_finding_id": {
          "type": "string",
          "minLength": 1
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "request_evidence",
            "object",
            "propose_alternative",
            "corroborate",
            "withdraw",
            "refer"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "arbitration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "reviewer_id",
        "attempt_id",
        "finding_ids",
        "competing_positions",
        "artifact_kind",
        "proof_observation",
        "evidence",
        "disposition",
        "reason",
        "remaining_dissent",
        "owner",
        "next_observation"
      ],
      "properties": {
        "type": {
          "const": "arbitration.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^AR-[0-9]{3}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competing_positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1
        },
        "proof_observation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "disposition": {
          "enum": [
            "candidate",
            "verified",
            "rejected",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "remaining_dissent": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "next_observation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "run_id",
        "base_sha",
        "head_sha",
        "sequence",
        "previous_digest",
        "event_root",
        "reservation_root",
        "blind_seal_digest",
        "cancelled",
        "run_epoch",
        "deadline_utc",
        "open_reservations"
      ],
      "properties": {
        "type": {
          "const": "checkpoint.v1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "previous_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reservation_root": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "blind_seal_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancelled": {
          "type": "boolean"
        },
        "run_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_utc": {
          "type": "string",
          "format": "date-time"
        },
        "open_reservations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_id",
              "state",
              "lease_epoch",
              "expires_utc",
              "token_reservation",
              "cost_reservation_microusd"
            ],
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "reserved",
                  "dispatched",
                  "uncertain"
                ]
              },
              "lease_epoch": {
                "type": "integer",
                "minimum": 1
              },
              "expires_utc": {
                "type": "string",
                "format": "date-time"
              },
              "token_reservation": {
                "type": "integer",
                "minimum": 1
              },
              "cost_reservation_microusd": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
